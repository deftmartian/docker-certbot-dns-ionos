#!/usr/bin/env python3
"""Rewrite the pinned Trivy SHA-256 in .forgejo/workflows/ci.yml to match its pinned version.

Renovate runs this after bumping TRIVY_VERSION (renovate.json postUpgradeTasks), so the version and its
checksum change in the same PR. Run it by hand after a manual bump too.

The new hash is written only when two records agree: the release's published checksums file, and the
SHA-256 of the tarball downloaded from the release. Any mismatch or download failure exits non-zero and
leaves the file alone, so the PR shows an artifact error instead of an unverified checksum.
"""
import hashlib
import os
import re
import sys
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CI = os.path.join(ROOT, ".forgejo/workflows/ci.yml")
BASE = "https://github.com/aquasecurity/trivy/releases/download/v{v}/"


def fetch(url):
    request = urllib.request.Request(url, headers={"User-Agent": "docker-certbot-dns-ionos renovate-checksums"})
    with urllib.request.urlopen(request, timeout=120) as response:
        return response.read()


def main():
    text = open(CI).read()
    version = re.search(r'^\s*TRIVY_VERSION:\s*"([^"]+)"', text, re.M)
    current = re.search(r'^(\s*TRIVY_SHA256:\s*")([0-9a-f]{64})(")', text, re.M)
    if not version or not current:
        sys.exit("TRIVY_VERSION or TRIVY_SHA256 not found in ci.yml")
    v = version.group(1)
    asset = f"trivy_{v}_Linux-64bit.tar.gz"
    checksums = fetch(BASE.format(v=v) + f"trivy_{v}_checksums.txt").decode()
    listed = [line.split()[0] for line in checksums.splitlines() if line.strip().endswith(" " + asset) or line.strip().endswith("*" + asset)]
    if len(listed) != 1 or not re.fullmatch(r"[0-9a-f]{64}", listed[0]):
        sys.exit(f"{asset} not listed exactly once in the release's checksums file")
    actual = hashlib.sha256(fetch(BASE.format(v=v) + asset)).hexdigest()
    if actual != listed[0]:
        sys.exit(f"{asset}: downloaded hash {actual} does not match the checksums file {listed[0]}")
    if current.group(2) == actual:
        print(f"trivy {v}: checksum already current")
        return
    updated = text[: current.start(2)] + actual + text[current.end(2):]
    tmp = CI + ".tmp"
    with open(tmp, "w") as handle:
        handle.write(updated)
    os.replace(tmp, CI)
    print(f"trivy {v}: pinned {actual}")


if __name__ == "__main__":
    main()
